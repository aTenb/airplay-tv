    <!-- 关于 -->
    <string name="section_about">关于与特色说明</string>
    <string name="about_app_name">AirPlay TV 原生增强版 (v1.1.0)</string>
    <string name="about_app_desc">专为 Android TV / 电视盒子深度定制的 Apple AirPlay 原生投屏接收端。</string>
    <string name="about_features_title">修改版核心特色</string>
    <string name="about_features_desc">1. 原生投屏：手机投屏直接黑底全屏弹出，无需手动打开 App\n2. 干净退出：投屏结束或遥控器按返回，秒级直回电视桌面，无页面闪烁\n3. 架构分离：开机后台静默守护，电视桌面图标纯作设置面板，平时无需打开\n4. 穿透唤醒：高优先级全屏意图，彻底解决 Android 10+ 后台启动拦截\n5. 双架构加速：支持 armeabi-v7a / arm64-v8a 低延迟硬解，画面原生无拉伸\n6. 中文优化：100% 简体中文本地化，彻底清理多余语言残留</string>
    <string name="about_license_title">开源协议与项目说明</string>
    <string name="about_license_desc">遵循 GPL-3.0 开源协议。基于开源项目 RPiPlay / UxPlay / FFmpeg 核心技术构建。</string>
