    <!-- About -->
    <string name="section_about">About &amp; Highlights</string>
    <string name="about_app_name">AirPlay TV Native Edition (v1.1.0)</string>
    <string name="about_app_desc">Apple AirPlay receiver optimized for Android TV with native cast experience.</string>
    <string name="about_features_title">Key Features</string>
    <string name="about_features_desc">1. Native cast: Pop up fullscreen directly without opening the app\n2. Clean exit: Return to TV desktop instantly with zero UI flash\n3. Standalone daemon: TV desktop icon serves purely as settings; no manual open needed\n4. Breakthrough wake-up: High priority fullScreenIntent bypassing Android 10+ background restrictions\n5. Dual ABI acceleration: Supports armeabi-v7a and arm64-v8a hardware decoding\n6. 100% Simplified Chinese localization</string>
    <string name="about_license_title">License &amp; Credits</string>
